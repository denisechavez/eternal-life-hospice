modules = ["nodejs-20", "python-3.11", "python3", "postgresql-16"]
[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales", "jbig2dec", "mupdf", "qpdf"]

[agent]
expertMode = true
integrations = ["javascript_openai_ai_integrations:2.0.0", "google-drive:1.0.0"]

[workflows]
runButton = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 website/devserver.py"
waitForPort = 5000

[[workflows.workflow]]
name = "city-script-regression-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 website/check-city-scripts.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "coverage-lookup-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node website/elh-preview/assets/test-coverage-lookup.js"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "alias-check"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 website/clean-stale-aliases.py --check --remove-redundant"

[[workflows.workflow]]
name = "rebuild-search-index"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node website/elh-preview/assets/build-search-index.js"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "header-parity-check"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 website/check-header-parity.py"

[[workflows.workflow]]
name = "pre-deploy-chain-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash website/test-predeploy-chain.sh"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 30000

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "python3 website/devserver.py"]
