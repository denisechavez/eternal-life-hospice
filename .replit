modules = ["nodejs-20", "python-3.11", "python3", "postgresql-16"]
[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales", "jbig2dec", "mupdf", "qpdf"]

[agent]
expertMode = true
integrations = ["javascript_openai_ai_integrations:2.0.0", "google-drive:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Outreach Tracker (internal)"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Reel Preview"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 website/devserver.py"
waitForPort = 5000

[[workflows.workflow]]
name = "Outreach Tracker (internal)"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd outreach-tracker && PORT=3000 npm start"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Reel Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/mockup-sandbox && npm run dev"
waitForPort = 5173

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 5174
externalPort = 3001

[[ports]]
localPort = 8099
externalPort = 8099

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 30000

[userenv]

[userenv.shared]

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd outreach-tracker && npm start"]
