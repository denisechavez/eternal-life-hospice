modules = ["nodejs-20", "python-3.11", "python3", "postgresql-16"]
[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales", "jbig2dec", "mupdf", "qpdf"]

[agent]
expertMode = true
integrations = ["javascript_openai_ai_integrations:2.0.0", "google-drive:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Reel Preview"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "backup-trim-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "focus-ring-check"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 website/devserver.py"
waitForPort = 5000

[[workflows.workflow]]
name = "Reel Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/mockup-sandbox && npm run dev"
waitForPort = 5173

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "backup-trim-test"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd exports/outreach-tracker-src && npm install --no-audit --no-fund && npm test"

[[workflows.workflow]]
name = "focus-ring-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd exports/outreach-tracker-src && node test-rechint-focus.js"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 5174
externalPort = 3001

[[ports]]
localPort = 8099
externalPort = 8099

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 30000

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "python3 website/devserver.py"]
build = ["bash", "-c", "cd exports/outreach-tracker-src && npm install --no-audit --no-fund && npm test"]
