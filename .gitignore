# Private, local-only data — never committed to Git, never published.
# Drop sensitive files (contact lists, exports to clean, etc.) in here.
_private-data/

# Replit-managed Python packages and generated interpreter metadata.
.pythonlibs/
__pycache__/
*.py[cod]

# Downloadable generated packages; keep out of Git and publishing.
/generated-artifacts/

# Built during publishing; draft chunks require authenticated server delivery.
/website/studio-build/

# Workspace-only copies of publicly released Journal pages; never approvals.
/.local/journal-preview/
